{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MaintenanceRepairEnvelope",
  "description": "Canonical structure for a maintenance layer Receipt (jsonl-line). Conformance is informational; the layer writes one envelope per line into telemetry/maintenance_receipts.jsonl.",
  "type": "object",
  "required": [
    "repair_id", "issue_id", "tier", "actor", "action", "outcome",
    "validation_status", "confidence", "before", "after",
    "rollback_snapshot", "lineage", "timestamp"
  ],
  "properties": {
    "repair_id":         { "type": "string", "pattern": "^rep-[0-9a-f]{12}$" },
    "issue_id":          { "type": "string", "pattern": "^iss-[0-9a-f]{12}$" },
    "tier":              { "type": "string", "enum": ["T1_COSMETIC", "T2_OPERATIONAL", "T3_LOGIC", "T4_SUBSTRATE"] },
    "actor":             { "type": "string" },
    "action":            { "type": "string" },
    "outcome":           { "type": "string", "enum": ["APPLIED", "DRY_RUN", "REJECTED", "ESCALATED", "UNRESOLVED"] },
    "validation_status": { "type": "string", "enum": ["VALIDATED", "FAILED", "SKIPPED", "UNRESOLVED"] },
    "confidence":        { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "before":            { "type": "object" },
    "after":             { "type": "object" },
    "rollback_snapshot": { "type": ["string", "null"] },
    "lineage":           { "type": "array", "items": { "type": "string" } },
    "timestamp":         { "type": "number" },
    "note":              { "type": "string" }
  },
  "additionalProperties": false
}
